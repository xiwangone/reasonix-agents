<?xml version="1.0" encoding="utf-8"?><!--
   Backup rules（API ≤ 30 生效，API 31+ 见 data_extraction_rules.xml）。
   凭据（服务器连接密码 / CI GitHub token）加密后仍不允许备份到云端或新设备，
   因为 AndroidKeyStore 密钥不随备份迁移，换机恢复后密文无法解密且存在泄漏面。
-->
<full-backup-content>
    <exclude domain="sharedpref" path="reasonix_server_config.xml"/>
    <exclude domain="sharedpref" path="reasonix_ci_monitor.xml"/>
</full-backup-content>

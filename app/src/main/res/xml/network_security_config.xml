<?xml version="1.0" encoding="utf-8"?>
<!--
  网络安全配置（批 A-1 放开明文）：cleartext 全局允许，支持公网 HTTP 明文连接。

  背景：本应用连接的是用户自建 Reasonix 服务器，地址不固定（公网 IP / 域名 / 内网 / Tailscale），
  无法像批 5 那样预置白名单；为支持公网 HTTP 场景，此处全局放开明文流量。

  风险由应用内 UI 承担：
    - 连接页首次选择 HTTP 时弹窗警告（一次性确认）
    - 连接页表单下方常驻小字「HTTP 明文不安全，推荐 HTTPS」
  注意：明文 HTTP 下用户名/密码/Token 等敏感信息以明文传输，请尽量使用 HTTPS。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
